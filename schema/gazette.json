{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kanpou Gazette",
  "type": "object",
  "required": ["source", "date", "issues"],
  "properties": {
    "source": {"type": "string"},
    "date": {"type": "string", "format": "date"},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {"type": "string"},
          "number": {"type": "string"},
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {"type": "string"},
                "title": {"type": "string"},
                "page": {"type": "integer", "minimum": 1},
                "source_url": {"type": "string", "format": "uri"}
              },
              "required": ["title"]
            }
          }
        }
      }
    }
  }
}
